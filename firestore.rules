rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 商品: 誰でも読み取りOK、書き込みは認証済みユーザー（管理者）のみ
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 注文: 匿名を含む認証済みユーザーが作成・読み取り可、更新・削除はメール認証ユーザーのみ
    // screenshotUrlフィールドのみ匿名ユーザーも更新可（スクショURL保存のため）
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.token.email != null ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['screenshotUrl'])
      );
      allow delete: if request.auth != null && request.auth.token.email != null;
    }

    // チャット: 匿名含む認証済みユーザーがcreate/update可（unread/lastMsg更新）、read/deleteはメール認証のみ
    match /chats/{chatId} {
      allow create, update: if request.auth != null;
      allow read, delete: if request.auth != null && request.auth.token.email != null;
    }
    // チャットメッセージ: 匿名含む認証済みユーザーが読み書き可
    match /chats/{chatId}/messages/{msgId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.email != null;
    }

    // 設定・通知リスト: メール認証ユーザーのみ
    match /settings/{docId} {
      allow read, write: if request.auth != null && request.auth.token.email != null;
    }

    // スクリーンショット: 匿名含む認証済みが作成可、読み取り・削除はメール認証のみ
    match /screenshots/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && request.auth.token.email != null;
    }

    // LINE送信キュー: 匿名含む認証済みが書き込み可、GASのため読み取り・更新は全員OK
    match /line_queue/{docId} {
      allow create: if request.auth != null;
      allow read, update: if true;
      allow delete: if request.auth != null && request.auth.token.email != null;
    }

    // LINE通知用公開設定: PHPプロキシから読み取り可能
    match /pub_config/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email != null;
    }

    // オーナー支払いスクショ: 匿名含む認証済みが作成可、読み取り・更新はメール認証のみ
    match /owner_payments/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && request.auth.token.email != null;
    }

    // オーナー集計データ（請求書履歴等）: メール認証のみ
    match /owner_data/{docId} {
      allow read, write: if request.auth != null && request.auth.token.email != null;
    }

    // adminsコレクション: 参照用に残す
    match /admins/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }

  }
}

